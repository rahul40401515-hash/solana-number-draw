# ============================================
# ENVIRONMENT VARIABLES - Solana Number Draw
# Copy to .env.local and fill in values
# ============================================

# ── Application ──────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ── Security ─────────────────────────────────
# ⚠️  CRITICAL: Never commit real secrets
NEXTAUTH_SECRET=change-me-to-a-random-64-char-string
NEXTAUTH_URL=http://localhost:3000
ADMIN_SECRET=your-admin-secret-here
JWT_SECRET=your-jwt-secret-here

# ── Telegram ─────────────────────────────────
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your bot username without @ (e.g. mynumberdrawbot)
TELEGRAM_BOT_USERNAME=
# Public URL where your Mini App is hosted
TELEGRAM_WEBAPP_URL=https://your-domain.com
# Webhook URL for bot updates (optional, for production)
TELEGRAM_WEBHOOK_URL=

# ── Database ─────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/numberdraw?schema=public

# ── Redis (for sessions, cache, rate limiting) ──
REDIS_URL=redis://localhost:6379

# ── Solana ────────────────────────────────────
# Network: devnet | testnet | mainnet-beta
SOLANA_NETWORK=devnet
# RPC endpoint - use Helius/QuickNode for production
SOLANA_RPC_URL=https://api.devnet.solana.com
# Treasury wallet PUBLIC key (receives payments)
TREASURY_WALLET=
# ⚠️  Treasury private key - NEVER expose to frontend
# Store in secure vault (AWS KMS, HashiCorp Vault) in production
TREASURY_WALLET_SECRET=

# ── Game Configuration ────────────────────────
# ⚠️  CRITICAL SAFETY SWITCH
# Set to true ONLY after legal compliance review
# When false: Devnet only, no real SOL, no real payouts
REAL_MONEY_MODE=false

# Default game settings (can be overridden per-round via admin)
DEFAULT_ENTRY_PRICE_LAMPORTS=50000000
DEFAULT_NUMBER_MIN=1
DEFAULT_NUMBER_MAX=5000
DEFAULT_WINNER_COUNT=5
DEFAULT_RESERVATION_TIMEOUT_MINUTES=5

# ── Randomness ────────────────────────────────
# Provider: switchboard | pyth | custom
# For production, use Switchboard VRF or similar
RANDOMNESS_PROVIDER=switchboard
SWITCHBOARD_PROGRAM_ID=
SWITCHBOARD_FEED_ID=

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Geographic Restrictions ───────────────────
# Comma-separated country codes (ISO 3166-1 alpha-2)
# Leave empty to allow all (dev mode)
BLOCKED_COUNTRIES=
ALLOWED_COUNTRIES=

# ── Compliance ────────────────────────────────
# Minimum age (jurisdiction-dependent)
MINIMUM_AGE=18
# Require KYC for payouts above threshold (lamports)
KYC_THRESHOLD_LAMPORTS=1000000000

# ── Email (optional, for notifications) ──────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# ── Monitoring / Logging ──────────────────────
LOG_LEVEL=info
SENTRY_DSN=
